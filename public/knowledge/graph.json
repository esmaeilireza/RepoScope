  "nodes": [
    {
      "id": "rule:iiot-001",
      "type": "rule",
      "label": "Missing Modbus error handler",
      "severity": "critical",
      "profile": "iiot",
      "rationale": "In OT environments, a Modbus timeout without exception handling can cause silent loss of telemetry and unreliable process decisions.",
      "fix": "Wrap Modbus reads in try/except for ModbusIOException.\nUse pymodbus.device.ModbusSimulatorServer as the test mock."
    },
    {
      "id": "rule:iiot-002",
      "type": "rule",
      "label": "Hardcoded PLC IP address",
      "severity": "error",
      "profile": "iiot",
      "rationale": "Hardcoded private OT addresses break environment portability and weaken network segmentation boundaries.",
      "fix": "Move PLC host addresses to environment variables, for example PLC_HOST, and keep real values out of source control."
    },
    {
      "id": "rule:iiot-003",
      "type": "rule",
      "label": "No requirements.txt pin",
      "severity": "warning",
      "profile": "iiot",
      "rationale": "Unpinned dependencies can introduce silent driver or library ABI changes in high-uptime industrial environments.",
      "fix": "Pin runtime dependencies with exact versions, for example pymodbus==3.6.3, and regenerate requirements.txt from a locked environment."
    },
    {
      "id": "rule:dataops-001",
      "type": "rule",
      "label": "Missing data pipeline tests",
      "severity": "critical",
      "profile": "dataops",
      "rationale": "Untested pipelines can pass corrupted data downstream and undermine trust in analytics outputs.",
      "fix": "Add at least one schema or expectation test for pipeline outputs, using tools such as pandera or great_expectations."
    },
    {
      "id": "rule:dataops-002",
      "type": "rule",
      "label": "No schema validation on ingestion",
      "severity": "error",
      "profile": "dataops",
      "rationale": "Ingestion without schema contracts allows upstream shape changes to corrupt downstream computation silently.",
      "fix": "Validate incoming datasets with an explicit schema contract before transformation or loading."
    },
    {
      "id": "rule:dataops-003",
      "type": "rule",
      "label": "Missing .env.example",
      "severity": "warning",
      "profile": "dataops",
      "rationale": "Without a sample environment file, contributors may miss required variables or commit real credentials.",
      "fix": "Add .env.example with placeholder keys and ensure real .env files are ignored by Git."
    },
    {
      "id": "rule:webapp-001",
      "type": "rule",
      "label": "No rate limiting on API routes",
      "severity": "critical",
      "profile": "webapp",
      "rationale": "APIs without rate limiting are exposed to abuse, cost blowups, and reliability degradation for all users.",
      "fix": "Add rate limiting to public API routes, for example with Upstash Ratelimit and Vercel KV or an equivalent gateway control."
    },
    {
      "id": "rule:webapp-002",
      "type": "rule",
      "label": "Missing Content Security Policy",
      "severity": "error",
      "profile": "webapp",
      "rationale": "Without CSP, injected scripts have a larger attack surface and browser-side mitigations are weaker.",
      "fix": "Configure a Content Security Policy header appropriate for the app, starting with restrictive defaults and explicit allowances."
    },
    {
      "id": "rule:general-001",
      "type": "rule",
      "label": "Potential hardcoded secret",
      "severity": "critical",
      "profile": "webapp",
      "rationale": "Credentials committed to source control remain exposed in Git history even after deletion.",
      "fix": "Move secrets to the runtime environment, rotate exposed credentials, and add secret scanning to CI."
    },
    {
      "id": "rule:cross-001",
      "type": "rule",
      "label": "IIoT + DataOps ABI conflict risk",
      "severity": "error",
      "profile": "cross",
      "rationale": "Mixing industrial drivers and analytics libraries in one environment can create silent dependency conflicts.",
      "fix": "Separate OT driver dependencies from analytics/data dependencies using isolated virtual environments or separate requirement files."
    },
    {
      "id": "rule:cross-002",
      "type": "rule",
      "label": "IIoT control plane exposed via web API",
      "severity": "warning",
      "profile": "cross",
      "rationale": "Web surfaces that reference PLC or Modbus controls can unintentionally bridge IT and OT safety boundaries.",
      "fix": "Require authentication and authorization for any API route that touches OT control paths, and enforce network segmentation between IT and OT."
    },
    {
