{
  "name": "my-reposcope-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "sbom": "node scripts/generate-sbom.mjs",
    "audit:self": "tsc --noEmit && eslint .",
    "audit:sec": "pnpm audit --registry=https://registry.npmjs.org/ --audit-level=high",
    "audit:all": "pnpm audit --registry=https://registry.npmjs.org/ --audit-level=high && node scripts/generate-sbom.mjs && eslint . && next build"
  },
  "dependencies": {
    "@cyclonedx/cyclonedx-library": "^10.2.0",
    "lucide-react": "^1.39.0",
    "next": "16.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.4",
    "typescript": "^5"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "overrides": {
      "braces": ">=3.0.3",
      "js-yaml": ">=4.3.2"
    }
  }
}
