{
  "name": "reposcope",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "bin": {
    "reposcope": "./bin/reposcope"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--no-warnings=DeprecationWarning' jest --passWithNoTests",
    "sbom": "node scripts/generate-sbom.mjs",
    "reposcope": "tsx scripts/reposcope-audit.ts",
    "audit:self": "tsx scripts/reposcope-audit.ts --repo . --strict",
    "audit:sec": "pnpm audit --registry=https://registry.npmjs.org/ --audit-level=high",
    "audit:all": "pnpm audit --registry=https://registry.npmjs.org/ --audit-level=high && python scripts/readme_status.py --check && node scripts/generate-sbom.mjs && eslint . && next build",
    "prebuild": "node -e \"process.exit(0)\"",
    "build:knowledge": "python scripts/build_knowledge.py",
    "kg:extract": "python scripts/kg/extract.py",
    "kg:assemble": "python scripts/kg/assemble_graph.py",
    "kg:validate": "python scripts/kg/validate_graph.py",
    "kg:seed": "python scripts/kg/seed.py",
    "kg:ground": "python scripts/kg/ground.py",
    "neo4j:up": "${NEO4J_HOME:?set NEO4J_HOME to the Neo4j install dir}/bin/neo4j start",
    "neo4j:down": "${NEO4J_HOME:?set NEO4J_HOME to the Neo4j install dir}/bin/neo4j stop",
    "neo4j:status": "${NEO4J_HOME:?set NEO4J_HOME to the Neo4j install dir}/bin/neo4j status",
    "kg:neo4j:import": "python scripts/kg/neo4j_import.py",
    "kg:neo4j:validate": "python scripts/kg/neo4j_validate.py",
    "kg:neo4j:export": "python scripts/kg/neo4j_export.py",
    "verify:registry": "tsx scripts/verify-knowledge-registry.ts",
    "gate:claims": "bash scripts/gates/check-grounded-claims.sh",
    "neo4j:schema": "scripts\\neo4j.bat schema",
    "semantic:calibrate": "tsx scripts/semantic-calibrate.ts",
    "semantic:clear-cache": "tsx scripts/semantic-reset-cache.ts",
    "semantic:debug": "tsx scripts/semantic-debug.ts",
    "check:spec-parity": "NODE_OPTIONS='--no-warnings=DeprecationWarning' jest --runInBand --testPathPattern contract/spec-parity",
    "check:spec-parity:cli": "tsx scripts/check-spec-parity.ts --repo __tests__/broken-dbt --profile dataops",
    "readme:status": "python scripts/readme_status.py",
    "readme:check": "python scripts/readme_status.py --check"
  },
  "dependencies": {
    "@cyclonedx/cyclonedx-library": "^10.2.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.1",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.0",
    "typescript": "^5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/fixtures/",
      "/__tests__/fixtures/"
    ]
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "overrides": {
      "braces": ">=3.0.3",
      "js-yaml": "^4.1.0",
      "zod": "^4.6.6"
    }
  }
}
