{
  "name": "reposcope",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "bin": {
    "reposcope": "./bin/reposcope"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "sbom": "node scripts/generate-sbom.mjs",
    "reposcope": "tsx scripts/reposcope-audit.ts",
    "audit:self": "tsx scripts/reposcope-audit.ts --repo . --strict",
    "audit:sec": "pnpm audit --registry=https://registry.npmjs.org/ --audit-level=high",
    "audit:all": "pnpm audit --registry=https://registry.npmjs.org/ --audit-level=high && node scripts/generate-sbom.mjs && eslint . && next build",
    "prebuild": "python3 scripts/build_knowledge.py || python scripts/build_knowledge.py",
    "kg:extract": "python scripts/kg/extract.py",
    "kg:assemble": "python scripts/kg/assemble_graph.py",
    "kg:validate": "python scripts/kg/validate_graph.py",
    "kg:neo4j:import": "python scripts/kg/neo4j_import.py",
    "kg:neo4j:validate": "python scripts/kg/neo4j_validate.py",
    "kg:neo4j:export": "python scripts/kg/neo4j_export.py",
    "verify:registry": "tsx scripts/verify-knowledge-registry.ts"
  },
  "dependencies": {
    "@cyclonedx/cyclonedx-library": "^10.2.0",
    "lucide-react": "^1.39.0",
    "next": "16.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.0",
    "typescript": "^5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/__tests__"],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        { "tsconfig": "tsconfig.json" }
      ]
    }
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": ["GHSA-vfj7-8cjw-p6xm"]
    },
    "overrides": {
      "braces": ">=3.0.3",
      "js-yaml": ">=4.1.0"
    }
  }
}